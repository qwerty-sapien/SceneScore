{
  "name": "scenescore-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "predev": "node apps/web/tools/catalog.mjs",
    "prebuild": "node apps/web/tools/catalog.mjs",
    "generate": "node tools/generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import tsx --test tests/ts/*.test.ts",
    "build": "vite build apps/web --outDir ../../artifacts/web-dist --emptyOutDir",
    "dev": "vite apps/web --host 127.0.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
